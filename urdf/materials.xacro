<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<material name="Black">
  <color rgba="0 0 0 1"/>
</material>
<material name="Blue">
  <color rgba="0 0 1 1"/>
</material>
<material name="Red">
  <color rgba="1 0 0 1"/>
</material>
